NODE_ENV=production
PORT=5000

# Frontend domains allowed to call the API.
CLIENT_URL=https://your-frontend-domain.vercel.app
CORS_ORIGINS=https://your-frontend-domain.vercel.app,https://www.yourdomain.com

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/bd_ai_ecommerce?retryWrites=true&w=majority

# JWT secrets must be unique, private, and at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-strong-32-plus-character-access-secret
JWT_REFRESH_SECRET=replace-with-a-strong-32-plus-character-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=bd-ai-ecommerce-api
JWT_AUDIENCE=bd-ai-ecommerce-client

# Manual payments
BKASH_MERCHANT_NUMBER=
NAGAD_MERCHANT_NUMBER=

# SSLCommerz placeholder credentials
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# AI provider placeholder
AI_PROVIDER=openai
AI_API_KEY=
